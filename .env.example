# Copie estos valores a variables de entorno en producción.
# No es necesario crear un archivo .env para ejecutar localmente: la app
# genera claves locales en instance/.secret_key e instance/.integrity_key.

# Clave de firma de cookies de sesión (mínimo 32 bytes aleatorios).
SECRET_KEY=cambie-esta-clave-por-una-aleatoria-de-64-caracteres

# Clave separada para HMAC de papeletas, actas y auditoría.
# Si se pierde, las actas existentes no podrán verificarse.
INTEGRITY_KEY=cambie-esta-clave-por-otra-aleatoria-de-64-caracteres

# Poner en 1 únicamente cuando la aplicación se sirva por HTTPS.
COOKIE_SECURE=0

# Opcionales para ejecución local.
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0

# Ruta alternativa del archivo SQLite. Por defecto: instance/voting.db
# DATABASE=C:\ruta\segura\voting.db

# Carpeta de respaldos automáticos. Por defecto: instance/backups
# BACKUP_DIR=C:\ruta\segura\respaldos
